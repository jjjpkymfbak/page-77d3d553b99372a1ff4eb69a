e\">\n    <h2>使用说明</h2>\n    <ul class=\"checklist\">\n      <li>\n        <strong>01. 确认需求与选择方案</strong>\n        <span>根据您的实际流量与设备数量诉求，在下方的套餐列表中挑选最契合的版本。</span>\n      </li>\n      <li>\n        <strong>02. 获取订阅凭证</strong>\n        <span>完成对应方案的开通流程后，您将获得专属的节点订阅地址或配置文件。</span>\n      </li>\n      <li>\n        <strong>03. 客户端导入与连接</strong>\n        <span>在您常用的主流客户端（如 Clash、Shadowrocket 等）中导入订阅链接，即可启用。</span>\n      </li>\n    </ul>\n  </section>\n\n  <section id=\"plans\">\n    <h2>服务套餐</h2>\n    <div class=\"plans-stack\">\n      <div class=\"plan-card\">\n        <div class=\"plan-header\">\n          <span class=\"plan-name\">基础版</span>\n          <span class=\"plan-price\">¥15/月</span>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n          <li>按年付仅需 ¥150/年</li>\n        </ul>\n        <a href=\"#\" class=\"plan-action\">选择基础版</a>\n      </div>\n\n      <div class=\"plan-card featured\">\n        <div class=\"plan-header\">\n          <span class=\"plan-name\">旗舰版</span>\n          <span class=\"plan-price\">¥35/月</span>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n          <li>按年付仅需 ¥350/年</li>\n        </ul>\n        <a href=\"#\" class=\"plan-action\">选择旗舰版</a>\n      </div>\n\n      <div class=\"plan-card\">\n        <div class=\"plan-header\">\n          <span class=\"plan-name\">团队版</span>\n          <span class=\"plan-price\">¥85/月</span>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n          <li>按年付仅需 ¥850/年</li>\n        </ul>\n        <a href=\"#\" class=\"plan-action\">选择团队版</a>\n  